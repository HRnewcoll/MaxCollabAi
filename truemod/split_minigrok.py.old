    STATIC_FILES["minigrok/tests/__init__.py"] = '"""minigrok.tests."""\n'

    STATIC_FILES["minigrok/core/security.py"] = dedent("""\
        \"\"\"minigrok/core/security.py — PII filter, injection check, path validation.\"\"\"
        from __future__ import annotations
        import re
        from pathlib import Path
        from typing import Optional, Tuple
        from minigrok.exceptions import SecurityError

        _PII = [r'\\b\\d{3}-\\d{2}-\\d{4}\\b', r'\\b\\d{16}\\b',
                r'\\b[\\w.+-]+@[\\w-]+\\.[A-Za-z]{2,}\\b', r'\\b\\d{3}[-.]?\\d{3}[-.]?\\d{4}\\b']

        _INJECT = re.compile(
            r'ignore.{0,5}previous|you.{0,5}are.{0,5}now|act.{0,5}as|'
            r'system.{0,5}prompt|jailbreak|disregard|override.{0,5}instructions',
            re.IGNORECASE)

        def pii_filter(text: str) -> str:
            for p in _PII: text = re.sub(p, "[REDACTED]", text)
            return text

        def injection_check(text: str) -> bool:
            return bool(_INJECT.search(text))

        def validate_tool_params(name: str, params: dict,
                                  registry: Optional[dict] = None) -> Tuple[bool, str]:
            if registry:
                expected = registry.get(name, {}).get("params", {})
                for k in params:
                    if expected and k not in expected:
                        return False, f"Unexpected param '{k}' for '{name}'"
            for k, v in params.items():
                if isinstance(v, str) and _INJECT.search(v):
                    return False, f"Suspicious content in param '{k}' — possible injection"
            return True, ""

        def validate_workspace_path(rel: str, workspace: str) -> Optional[Path]:
            try:
                resolved = (Path(workspace) / rel).resolve()
                if not str(resolved).startswith(str(Path(workspace).resolve())):
                    return None
                return resolved
            except Exception:
                return None
    """)

    STATIC_FILES["minigrok/tools/plugins.py"] = dedent("""\
        \"\"\"minigrok/tools/plugins.py — load custom tools from workspace/plugins/.\"\"\"
        from __future__ import annotations
        import logging
        from pathlib import Path
        log = logging.getLogger("minigrok")

        def load_plugins(registry: dict) -> int:
            import minigrok.state as state
            plugin_dir = Path(state.DIRS.get("ws_plugins", "/tmp/plugins"))
            loaded = 0
            for f in plugin_dir.glob("*.py"):
                try:
                    spec = {"__file__": str(f), "__name__": f.stem}
                    exec(compile(f.read_text(), str(f), "exec"), spec)  # noqa
                    if isinstance(spec.get("TOOLS"), dict):
                        for n, d in spec["TOOLS"].items():
                            if "fn" in d and "desc" in d:
                                registry[n] = d; loaded += 1
                except (SyntaxError, ImportError) as e:
                    log.warning(f"Plugin {f.stem}: {e}")
                except Exception as e:
                    log.warning(f"Plugin {f.stem} ({type(e).__name__}): {e}")
            return loaded
    """)

