    STATIC_FILES["minigrok/core/__init__.py"] = '"""minigrok.core — model, cache, memory, security, database."""\n'
    STATIC_FILES["minigrok/tools/__init__.py"] = dedent("""\
        \"\"\"minigrok.tools — tool registry builder.\"\"\"
        from __future__ import annotations
        import logging
        from typing import Dict
        log = logging.getLogger("minigrok")
        TOOL_REGISTRY: Dict[str, dict] = {}

        def build_registry() -> Dict[str, dict]:
            \"\"\"Import all tool modules and register their tools.\"\"\"
            import minigrok.state as state
            from minigrok.tools.web       import get_tools as _w
            from minigrok.tools.code      import get_tools as _c
            from minigrok.tools.browser   import get_tools as _b
            from minigrok.tools.homework  import get_tools as _h
            from minigrok.tools.workspace import get_tools as _ws
            from minigrok.tools.media     import get_tools as _m
            from minigrok.tools.plugins   import load_plugins
            for fn in [_w, _c, _b, _h, _ws, _m]:
                try:    TOOL_REGISTRY.update(fn())
                except Exception as e: log.warning(f"Tool reg failed: {e}")
            n = load_plugins(TOOL_REGISTRY)
            if n: log.info(f"Loaded {n} plugin tools")
            state.TOOL_REGISTRY = TOOL_REGISTRY  # type: ignore
            log.info(f"Tool Registry: {len(TOOL_REGISTRY)} tools")
            return TOOL_REGISTRY
    """)

    STATIC_FILES["minigrok/agents/__init__.py"] = '"""minigrok.agents — orchestration and chaining."""\n'
