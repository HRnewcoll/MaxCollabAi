#!/usr/bin/env python3
"""
split_minigrok.py
=================
Run this script ONCE to split minigrok_v13.py into the full package structure.

Usage:
    python split_minigrok.py                        # reads minigrok_v13.py in cwd
    python split_minigrok.py --src /path/to/v13.py  # custom source path
    python split_minigrok.py --out ./minigrok_pkg   # custom output directory

The script:
  1. Reads minigrok_v13.py
  2. Extracts each section by line range
  3. Writes every module file with correct imports
  4. Creates pyproject.toml, README.md, colab_cell.py
  5. Runs a syntax check on every generated file
  6. Prints a pass/fail report
"""

import argparse
import ast
import os
import sys
from pathlib import Path
from textwrap import dedent


# ════════════════════════════════════════════════════════════════════
# STANDARD FILE HEADERS  (prepended to every module)
# ════════════════════════════════════════════════════════════════════

